# Build output: `pnpm build` regenerates it from `src/`.
lib/

# Packed artifact: `pnpm pack` writes it into this directory, and it is a build
# product of the tree that produced it, not a source file. It is ignored so that
# a release check cannot leave the working tree dirty, and so that a stale
# tarball is never mistaken for the current candidate.
dsh-document-selection-ask-*.tgz

# Dependencies, installed from the registry into this directory only.
node_modules/

# Test and tooling artifacts.
test-results/
playwright-report/
coverage/
*.tsbuildinfo

# Disposable session workspace the real-DSH browser smoke points a live instance
# at, and the scratch directory it is served from. Its fixture files are
# generated per run rather than committed: they exist so the shell's own file
# reference picker and document viewer have something real to open, and a
# committed copy would be a second, silently diverging source of the same
# fixture text.
#
# The name carries no leading dot on purpose. The shell's file picker omits
# dot-entries, so a hidden directory would be unreachable from the very UI the
# smoke drives.
smoke-fixtures/
.smoke-run/

# Local environment files. The plugin reads no .env at runtime; these are
# ignored so that a developer's local secrets cannot reach a public commit.
.env
.env.*

# Editor and OS by-products.
.DS_Store
Thumbs.db
