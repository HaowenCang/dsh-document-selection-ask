{
  "name": "dsh-document-selection-ask",
  "version": "0.1.0",
  "private": true,
  "description": "DSH client plugin: select content in TXT/Markdown/code/CSV/PDF/DOCX/PPTX/XLSX document previews and append a provenance-aware quote to the current conversation draft.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./lib/index.mjs",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.mjs"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.mjs",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "dsh:doctor": "node scripts/dsh-doctor.mjs",
    "check:dsh-contracts": "node scripts/check-dsh-contracts.mjs",
    "typecheck": "tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "verify": "node scripts/verify.mjs",
    "build": "tsdown && tsc -p tsconfig.build.json",
    "smoke:driver": "tsdown --config tsdown.smoke-driver.config.ts",
    "smoke:profile": "node scripts/dsh-smoke-profile.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-client-store": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-dockkit": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-documentpreview": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.2",
    "@pdf-lib/fontkit": "1.1.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.0",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "docx": "9.7.1",
    "exceljs": "4.4.0",
    "jsdom": "30.0.1",
    "pdf-lib": "1.17.1",
    "playwright": "1.63.0",
    "pptxgenjs": "4.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.23.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "1.2.4",
    "@extend-ai/react-xlsx": "0.16.4",
    "@zip.js/zip.js": "2.15.0",
    "docx-preview": "0.4.0",
    "pdfjs-dist": "6.3.289"
  }
}
